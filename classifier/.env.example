GNANI_API_KEY=your_gnani_api_key_here
MONGODB_URI=mongodb://127.0.0.1:27017/scamalert
PORT=8000
# Optional Claude reasoning layer (substitute for Gnani's Evon, which is not on the API). Leave unset to run Gnani + rules only.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# Shared secret between backend and classifier (any long random string; set the same value on both).
# INTERNAL_TOKEN=
